<!--
  AppTheme.axaml — STTmini 集中式样式层（B 方案：卡片现代 / Linear-Notion 风）。
  来源：prototype/ui-redesign/styles.css 变体 B 的 token 翻译为 Avalonia class 选择器。
  用法：控件加 Classes="card" / "primary" / "input-pill" 等即套用；App.axaml 用 StyleInclude 合并。
  设计语言：浅灰底 + 白卡片 + 柔阴影 + 靛蓝强调（#5B5BD6），大圆角（14/9/8）。
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============ 颜色资源（B 方案 token，已合并近重复色） ============
       Mini 取舍：表面/边框各只留一个语义名，不做 #EBEDF0/#F0F1F3/#E1E2E6 这种
       肉眼难辨的细分（原型的三层灰在桌面缩放下无意义）。 -->
  <Styles.Resources>
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F4F5F7" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#5B5BD6" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#4A4AC8" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E5484D" />
    <SolidColorBrush x:Key="BorderBrush" Color="#EBEDF0" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2329" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#646A73" />
    <SolidColorBrush x:Key="TextStatusBrush" Color="#8A8F94" />
    <SolidColorBrush x:Key="InputFillBrush" Color="#F7F8FA" />
    <SolidColorBrush x:Key="ResultFillBrush" Color="#FAFBFC" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="#EEF0F3" />
    <!-- 批量列表状态色（AGENTS.md §4.5 / §6.3） -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#1A8754" />
    <SolidColorBrush x:Key="PendingBrush" Color="#9AA0A6" />
    <SolidColorBrush x:Key="RunningBrush" Color="#5B5BD6" />
  </Styles.Resources>

  <!-- ============ Window 基底（字体走系统默认 UI 字体；不内嵌 Inter，见 Program.cs） ============ -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource PageBackgroundBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- ============ 顶部应用栏 ============ -->
  <Style Selector="Border.appbar">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="28,14" />
  </Style>

  <!-- ============ 主卡片（白底 + 大圆角 + 双层柔阴影） ============ -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BoxShadow" Value="0 1 3 0 rgba(15,23,42,0.04), 0 8 24 0 rgba(15,23,42,0.06)" />
    <Setter Property="Margin" Value="28,0" />
  </Style>

  <!-- 卡片 header 行（logo + 品牌 + 齿轮）：与 card-section 同语言，但语义是卡片标题行（§6.6）。
       appbar 移除后，品牌与设置入口落脚于此。 -->
  <Style Selector="Border.card-header">
    <Setter Property="Padding" Value="28,16" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <!-- 卡片内分段（细底分割线，最后一段无线） -->
  <Style Selector="Border.card-section">
    <Setter Property="Padding" Value="28,22" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.card-section:last-child">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- ============ 文件输入胶囊 ============
       Padding 14,9 与同行 primary 按钮（Padding 16,9）垂直对齐；
       早期 14,12 让胶囊偏高、与 CTA 不齐。 -->
  <Style Selector="Border.input-pill">
    <Setter Property="Background" Value="{StaticResource InputFillBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="14,9" />
  </Style>

  <!-- ============ 结果区面板 ============ -->
  <Style Selector="Border.result-panel">
    <Setter Property="Background" Value="{StaticResource ResultFillBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <!-- ============ 操作条（卡片底） ============ -->
  <Style Selector="Border.action-bar">
    <Setter Property="Background" Value="{StaticResource ResultFillBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="28,16" />
  </Style>

  <!-- ============ 按钮 ============ -->
  <!-- 次按钮：白底 + 边框 -->
  <Style Selector="Button.btn">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button.btn:pointerover">
    <Setter Property="Background" Value="{StaticResource PageBackgroundBrush}" />
  </Style>

  <!-- 主按钮：靛蓝 #5B5BD6 -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button.primary:pointerover">
    <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
  </Style>

  <!-- 危险按钮：红字 -->
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button.danger:pointerover">
    <Setter Property="Background" Value="{StaticResource PageBackgroundBrush}" />
  </Style>

  <!-- 图标按钮（设置齿轮）：32×32 + 圆角 -->
  <Style Selector="Button.icon-btn">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon-btn:pointerover">
    <Setter Property="Background" Value="{StaticResource PageBackgroundBrush}" />
  </Style>

  <!-- 文字按钮（链接样式，如"浏览…"） -->
  <Style Selector="Button.text-link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button.text-link:pointerover">
    <Setter Property="Foreground" Value="{StaticResource PrimaryHoverBrush}" />
  </Style>

  <!-- ============ 文本块 ============ -->
  <Style Selector="TextBlock.field-label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>

  <Style Selector="TextBlock.status-text">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TextStatusBrush}" />
  </Style>

  <Style Selector="TextBlock.brand">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <!-- ============ 进度条 ============ -->
  <Style Selector="ProgressBar.card-bar">
    <Setter Property="Height" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="Background" Value="{StaticResource ProgressBarTrackBrush}" />
  </Style>

  <!-- ============ 结果文本（等宽） ============ -->
  <Style Selector="TextBox.result-text">
    <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Menlo,monospace" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="IsReadOnly" Value="True" />
  </Style>

  <!-- ============ 顶栏 logo（app icon PNG，无渐变；24×24 等比缩放） ============
       Image 走 PNG 解码路径（比 ICO 稳）；Source 由各 View 的 <Image Source="avares://..."/> 提供。 -->
  <Style Selector="Image.logo">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Stretch" Value="Uniform" />
  </Style>

  <!-- ============ 模式 Tab 切换 [单文件 | 批量]（AGENTS.md §4.5 / §6.2）============
       下划线 Tab：Tab 条透明、紧贴卡片左右 padding；Tab 项默认灰色字、选中态主色字 +
       底部主色下划线（Fluent TabItem 模板自带 selection indicator，这里只覆盖颜色与文字）。
       早期版本用 Border.segmented 胶囊 + RadioButton.segmented-item；现已改为真 TabControl。 -->
  <!-- TabControl 容器：去默认边框/背景，让卡片内干净嵌套；内容区不留 padding -->
  <Style Selector="TabControl.mode-tab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <!-- Tab 条（TabStrip）：透明底、左右贴卡片 padding 28、底部 1px 分割线 -->
  <Style Selector="TabControl.mode-tab /template/ TabStrip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Margin" Value="28,0" />
  </Style>
  <!-- 单个 Tab 项（未选中）：透明底、灰色字、半粗、内边距 -->
  <Style Selector="TabControl.mode-tab TabItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,10" />
  </Style>
  <!-- hover：提前变主色字。三态走「灰 → 靛蓝（hover）→ 靛蓝 + 下划线（选中）」，
       hover 与选中字色相同、仅靠下划线区分——避免 Fluent 默认把 hover 字渲成黑色
       跳出灰→靛蓝色系（用户反馈的「配色割裂」）。 -->
  <Style Selector="TabControl.mode-tab TabItem:pointerover">
    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
  </Style>
  <!-- 选中态：主色字（+ 下方 IndicatorTemplate 提供的下划线，与本条字色共同标识选中） -->
  <Style Selector="TabControl.mode-tab TabItem:selected">
    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
  </Style>
  <!-- 选中态下划线指示器：用 PrimaryBrush 重写 IndicatorTemplate（Rectangle），
       覆盖 Fluent 默认色（默认是系统/Azure 色）。限定 :selected——指示器语义上只属于选中项，
       避免对未选中 TabItem 套上一个永不被渲染的模板（Speculative Generality）。
       TabItem.IndicatorTemplate 类型是 IDataTemplate——Avalonia XAML 用 <DataTemplate>
       而非 <Template>（后者是 IControlTemplate，类型不匹配会运行期抛 InvalidCastException）。 -->
  <Style Selector="TabControl.mode-tab TabItem:selected">
    <Setter Property="IndicatorTemplate">
      <DataTemplate>
        <Rectangle Fill="{StaticResource PrimaryBrush}" Height="2" VerticalAlignment="Bottom" />
      </DataTemplate>
    </Setter>
  </Style>

  <!-- ============ 批量文件列表（AGENTS.md §4.5 / §6.3）============
       result-panel 复用为列表容器；每行 batch-row：状态圆点 + 文件名 + 状态文案。
       行间用 1px 底分割线，整列表内部滚动（卡片 * 行驱动高度）。 -->
  <Style Selector="Border.batch-list">
    <Setter Property="Background" Value="{StaticResource ResultFillBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <!-- 行内状态圆点：默认灰（等待），按 datacontext 状态着色由 ListBoxItem 内部绑定 -->
  <Style Selector="Ellipse.status-dot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
  </Style>
  <!-- 批量空态提示 -->
  <Style Selector="TextBlock.batch-empty">
    <Setter Property="Foreground" Value="{StaticResource TextStatusBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ============ 批量空态拖放区（虚线边框 + 大留白，AGENTS.md §6.6）============
       Aiko / 下载管理器模式：空列表时显示一块虚线拖放区，引导用户拖入。
       高度由 * 行弹性撑开；有项后隐藏。用偏灰边框（TextStatusBrush）模拟虚线观感
       （Avalonia 12 Border 不直接支持 dash，实线近似已足够）。 -->
  <Style Selector="Border.drop-zone">
    <Setter Property="Background" Value="{StaticResource ResultFillBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource TextStatusBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="24" />
    <Setter Property="MinHeight" Value="160" />
  </Style>

  <!-- ============ 行内 × 移除按钮（常驻，AGENTS.md §6.6）============
       HandBrake / Adobe Media Encoder 模式：每行右侧常驻小 × 按钮，前景灰、hover 变红。
       运行中行 IsEnabled=false（VM 驱动）。 -->
  <Style Selector="Button.batch-remove">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextStatusBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.batch-remove:pointerover">
    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    <Setter Property="Background" Value="{StaticResource PageBackgroundBrush}" />
  </Style>

  <!-- ============ 行内细进度条（仅运行中行，AGENTS.md §6.6）============
       2px 高 + 主色前景 + 透明 track，与顶部整体进度条互补（一个看总、一个看当前文件）。 -->
  <Style Selector="ProgressBar.batch-row-bar">
    <Setter Property="Height" Value="2" />
    <Setter Property="CornerRadius" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinWidth" Value="120" />
  </Style>

  <!-- ============ ListBoxItem 强调色统一（AGENTS.md §6.6）============
       Fluent 主题的 ListBoxItem 选中/hover 高亮默认走「系统强调色」（Windows 默认蓝 #0078D4），
       与本设计的靛蓝 #5B5BD6 不一致——会看到「列表选中蓝 vs 行内进度条靛蓝」的割裂。
       这里用 :selected / :pointerover 伪类直接覆盖背景色，把列表强调色统一到 PrimaryBrush。

       注意：CheckBox 不在此列——曾经把勾选态的 Path / Border 也改主色，但勾选框整体填主色
       视觉过重、与卡片轻盈基调不协调，已回滚。CheckBox 维持 Fluent 默认外观。 -->

  <!-- ListBoxItem 选中/hover 高亮：用 PrimaryBrush 的低透明度派生（10% / 14% alpha）做柔和底，
       替代 Fluent 默认的半透明系统蓝。批量列表的 ListBox 背景透明、行内自有状态色，选中态弱表达即可。 -->
  <Style Selector="ListBoxItem:pointerover">
    <Setter Property="Background" Value="#105B5BD6" />
  </Style>
  <Style Selector="ListBoxItem:selected">
    <Setter Property="Background" Value="#1A5B5BD6" />
  </Style>
  <Style Selector="ListBoxItem:selected:pointerover">
    <Setter Property="Background" Value="#265B5BD6" />
  </Style>

</Styles>
